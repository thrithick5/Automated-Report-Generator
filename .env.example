# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# Database
# Local (default):
DATABASE_URL=sqlite:///./data/reports.db
# Vercel (Postgres required - filesystem is read-only). Example with Neon:
# DATABASE_URL=postgresql://user:password@host/dbname

# GitHub (optional - required for private repositories)
GITHUB_TOKEN=

# Vercel Cron protection - set a secret and add the CRON_SECRET env var on Vercel
CRON_SECRET=

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
